# Artify Tools — optional configuration. Nothing here is required for the
# browser-based tools. Never prefix secrets with NEXT_PUBLIC_.

# Public contact address shown on /contact (safe to expose). Leave unset until a
# real support mailbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=

# AI Text Summarizer (server-side only). Without a key the tool reports
# "requires configuration" and never fabricates output.
ANTHROPIC_API_KEY=
# Optional model override for the AI provider.
AI_MODEL=

# Cheque Printer: when a visitor shares a custom cheque size, a GitHub issue is opened so you are notified.
# Server-side only. Needs a token that can write issues on the repo; without it, sharing is switched off.
CHEQUE_SHARE_GITHUB_TOKEN=
# Optional: owner/repo that receives the issues (defaults to usmanclaude92-creator/artifytools).
CHEQUE_SHARE_GITHUB_REPO=
